# Copy to lab.auto.tfvars (gitignored) and fill in. The subscription ID stays
# out of the public repo; Terraform loads *.auto.tfvars automatically.
subscription_id = "00000000-0000-0000-0000-000000000000" # the lab subscription (az account show --query id -o tsv)

